# AgentDuet connector
AGENTDUET_API_KEY=your-connector-api-key
AGENTDUET_CONNECTOR_UUID=your-connector-uuid

# Gemini Live (after-hours AI voicemail)
GEMINI_API_KEY=

# Slack Incoming Webhook (required for team notify)
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Business hours (local wall clock in BUSINESS_TZ)
BUSINESS_TZ=UTC
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
# Comma-separated weekdays: 0=Mon … 6=Sun
BUSINESS_DAYS=0,1,2,3,4

# Set to 1 to always take a voicemail (skip business-hours connect)
# FORCE_AFTER_HOURS=1

# Optional ring time when connecting during business hours
# CONNECT_RING_SECONDS=30
