# AgentDuet connector
AGENTDUET_API_KEY=your-connector-api-key
AGENTDUET_CONNECTOR_UUID=your-connector-uuid

# Amazon Nova 2 Sonic (Bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
NOVA_MODEL_ID=amazon.nova-2-sonic-v1:0
NOVA_VOICE_ID=tiffany
NOVA_ENDPOINTING_SENSITIVITY=HIGH
AUDIO_SAMPLE_RATE=24000

# Pipedrive (omit PIPEDRIVE_API_TOKEN to mock → data/cases/*.json)
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=
# PIPEDRIVE_LOST_STAGE_ID=
# PIPEDRIVE_COMPLAINT_STAGE_ID=
# PIPEDRIVE_STAGE_ID=

# Optional Telegram notify when a case is finalized
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_SUPPORT_CHAT_ID=

# RESOLVE_OPENING_GREETING=Hello, VibeRider Resolve here. Are you calling as a rider or a driver?

# Optional
LOG_LEVEL=INFO
