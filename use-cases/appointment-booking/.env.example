# AgentDuet connector
AGENTDUET_API_KEY=your-connector-api-key
AGENTDUET_CONNECTOR_UUID=your-connector-uuid

# Gemini Live
GEMINI_API_KEY=

# Google Calendar (optional — without these, an in-memory demo calendar is used)
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CREDENTIALS=./calendar-service-account.json
# BUSINESS_TZ=UTC

# Confirmation message with booking_id + event_id (optional — skipped if unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_CUSTOMER_CHAT_ID=
