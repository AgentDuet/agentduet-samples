# AgentDuet Telephony Credentials (from https://agentduet.com)
AGENTDUET_API_KEY=your_agentduet_api_key
AGENTDUET_CONNECTOR_UUID=your_agentduet_connector_uuid
AGENTDUET_SUBSCRIBER=+15551234567

# Gemini Live Realtime Speech Model (from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview

# Make.com Webhook URLs (Custom Webhook modules in your Make scenarios)
MAKE_AVAILABILITY_WEBHOOK_URL=https://hook.eu1.make.com/your-availability-webhook-id
MAKE_BOOKING_WEBHOOK_URL=https://hook.eu1.make.com/your-booking-webhook-id
MAKE_API_KEY=your_optional_make_bearer_token

# Optional: Run in mock mode without live Make.com webhooks
MAKE_MOCK_MODE=false
