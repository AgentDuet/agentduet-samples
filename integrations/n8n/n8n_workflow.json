{
  "name": "Cab Company Lost and Found: AgentDuet + Google Sheets",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lost-and-found-intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-intake",
      "name": "AgentDuet Intake Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.role || $json.body.caller_type }}",
                    "rightValue": "driver",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.role || $json.body.caller_type }}",
                    "rightValue": "customer",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        }
      },
      "id": "switch-caller-type",
      "name": "Route Driver vs Customer",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [320, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Found_Items",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $now.toISO() }}",
            "Item_Type": "={{ $json.body.item_type }}",
            "Detail_1": "={{ $json.body.distinguishing_detail_1 }}",
            "Detail_2": "={{ $json.body.distinguishing_detail_2 }}",
            "Approx_Trip_Time": "={{ $json.body.approx_trip_time }}",
            "Route_Area": "={{ $json.body.route_area }}",
            "Seat_Position": "={{ $json.body.seat_position }}",
            "Driver_Phone": "={{ $json.body.callback_number || $json.body.driver_phone }}",
            "Status": "open"
          }
        },
        "options": {}
      },
      "id": "sheets-insert-found",
      "name": "Insert into Found_Items",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [560, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Lost_Items",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $now.toISO() }}",
            "Item_Type": "={{ $json.body.item_type }}",
            "Detail_1": "={{ $json.body.distinguishing_detail_1 }}",
            "Detail_2": "={{ $json.body.distinguishing_detail_2 }}",
            "Approx_Trip_Time": "={{ $json.body.approx_trip_time }}",
            "Route_Area": "={{ $json.body.route_area }}",
            "Customer_Phone": "={{ $json.body.callback_number || $json.body.customer_phone }}",
            "Ride_ID": "={{ $json.body.ride_id }}",
            "Status": "open"
          }
        },
        "options": {}
      },
      "id": "sheets-insert-lost",
      "name": "Insert into Lost_Items",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [560, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"success\",\n  \"message\": \"Intake report recorded in Google Sheets\",\n  \"report_id\": {{ $json.row_number || $json.id || 101 }}\n}"
      },
      "id": "respond-intake",
      "name": "Respond to AgentDuet",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [800, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lost-and-found-lookup",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-lookup",
      "name": "Pre-Intake Lookup Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 600]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Lost_Items",
          "mode": "name"
        },
        "filtersUi": {
          "criteria": [
            {
              "column": "Customer_Phone",
              "operator": "equals",
              "value": "={{ $json.body.caller_phone }}"
            },
            {
              "column": "Status",
              "operator": "equals",
              "value": "pending_confirmation"
            }
          ]
        },
        "options": {}
      },
      "id": "sheets-lookup-case",
      "name": "Lookup Open Case in Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [340, 600]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"has_open_case\": {{ $json.length > 0 }},\n  \"case\": {{ $json.length > 0 ? $json[0] : null }}\n}"
      },
      "id": "respond-lookup",
      "name": "Respond Lookup to AgentDuet",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [580, 600]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lost-and-found-status",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-status",
      "name": "Case Status Update Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 800]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Lost_Items",
          "mode": "name"
        },
        "matchColumn": "Row",
        "matchValue": "={{ $json.body.case_id }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Status": "={{ $json.body.status }}"
          }
        },
        "options": {}
      },
      "id": "sheets-update-status",
      "name": "Update Status in Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [340, 800]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"success\",\n  \"case_id\": {{ $json.body.case_id }},\n  \"updated_status\": \"{{ $json.body.status }}\"\n}"
      },
      "id": "respond-status",
      "name": "Respond Status Update",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [580, 800]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 2 * * *" }
          ]
        }
      },
      "id": "cron-expiration",
      "name": "Nightly Expiration Schedule",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [100, 1000]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Lost_Items",
          "mode": "name"
        },
        "filtersUi": {
          "criteria": [
            { "column": "Status", "operator": "equals", "value": "open" }
          ]
        },
        "options": {}
      },
      "id": "sheets-query-expired",
      "name": "Query Stale Open Records in Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [340, 1000]
    }
  ],
  "connections": {
    "AgentDuet Intake Webhook": {
      "main": [
        [{ "node": "Route Driver vs Customer", "type": "main", "index": 0 }]
      ]
    },
    "Route Driver vs Customer": {
      "main": [
        [{ "node": "Insert into Found_Items", "type": "main", "index": 0 }],
        [{ "node": "Insert into Lost_Items", "type": "main", "index": 0 }]
      ]
    },
    "Insert into Found_Items": {
      "main": [
        [{ "node": "Respond to AgentDuet", "type": "main", "index": 0 }]
      ]
    },
    "Insert into Lost_Items": {
      "main": [
        [{ "node": "Respond to AgentDuet", "type": "main", "index": 0 }]
      ]
    },
    "Pre-Intake Lookup Webhook": {
      "main": [
        [{ "node": "Lookup Open Case in Google Sheets", "type": "main", "index": 0 }]
      ]
    },
    "Lookup Open Case in Google Sheets": {
      "main": [
        [{ "node": "Respond Lookup to AgentDuet", "type": "main", "index": 0 }]
      ]
    },
    "Case Status Update Webhook": {
      "main": [
        [{ "node": "Update Status in Google Sheets", "type": "main", "index": 0 }]
      ]
    },
    "Update Status in Google Sheets": {
      "main": [
        [{ "node": "Respond Status Update", "type": "main", "index": 0 }]
      ]
    },
    "Nightly Expiration Schedule": {
      "main": [
        [{ "node": "Query Stale Open Records in Google Sheets", "type": "main", "index": 0 }]
      ]
    }
  }
}
