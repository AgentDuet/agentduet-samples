{
  "name": "AgentDuet Restaurant Table Reservation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "restaurant-reservation",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-reservation",
      "name": "Reservation Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300],
      "webhookId": "agentduet-restaurant-reservation"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Reservations",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $now.toISO() }}",
            "Guest_Name": "={{ $json.body.guest_name }}",
            "Party_Size": "={{ $json.body.party_size }}",
            "Reservation_Time": "={{ $json.body.reservation_time }}",
            "Phone_Number": "={{ $json.body.phone_number }}",
            "Special_Requests": "={{ $json.body.special_requests || 'None' }}",
            "Status": "confirmed"
          }
        },
        "options": {}
      },
      "id": "sheets-insert-reservation",
      "name": "Insert into Reservations",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [460, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"confirmed\",\n  \"confirmation_code\": \"RES-{{ Math.floor(1000 + Math.random() * 9000) }}\",\n  \"message\": \"Table reserved for {{ $('Reservation Webhook').item.json.body.guest_name }} (party of {{ $('Reservation Webhook').item.json.body.party_size }}) at {{ $('Reservation Webhook').item.json.body.reservation_time }}\",\n  \"guest_name\": \"{{ $('Reservation Webhook').item.json.body.guest_name }}\",\n  \"party_size\": {{ $('Reservation Webhook').item.json.body.party_size }},\n  \"reservation_time\": \"{{ $('Reservation Webhook').item.json.body.reservation_time }}\"\n}"
      },
      "id": "respond-reservation",
      "name": "Respond to AgentDuet",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [700, 300]
    }
  ],
  "pinData": {},
  "connections": {
    "Reservation Webhook": {
      "main": [
        [
          {
            "node": "Insert into Reservations",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insert into Reservations": {
      "main": [
        [
          {
            "node": "Respond to AgentDuet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1"
}
