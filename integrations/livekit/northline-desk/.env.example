# AgentDuet connector
AGENTDUET_API_KEY=your-connector-api-key
AGENTDUET_CONNECTOR_UUID=your-connector-uuid

# LiveKit Cloud or self-hosted
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini Live (used by agent_worker.py via livekit-plugins-google)
GOOGLE_API_KEY=
# GEMINI_API_KEY=   # also accepted by some Google tooling

# Optional barge-in energy threshold for clearing AgentDuet playback
# BARGE_RMS_THRESHOLD=400
