# AgentDuet connector
AGENTDUET_API_KEY=your-connector-api-key
AGENTDUET_CONNECTOR_UUID=your-connector-uuid

# Gemini Live — speech in/out only (not the assistant brain)
GEMINI_API_KEY=
# GEMINI_VOICE=Zephyr
# AGENT_NAME=Ada

# OpenClaw Gateway (required). Enable:
#   gateway.http.endpoints.chatCompletions.enabled = true
# Keep this URL private (loopback, Tailscale, SSH tunnel). The token is
# full operator access to the gateway.
# https://docs.openclaw.ai/gateway/openai-http-api
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_MODEL=openclaw/default
# OPENCLAW_TIMEOUT_SECONDS=90
# OPENCLAW_FILLER=1
# UTTERANCE_SILENCE_SECONDS=1.4
