# AgentDuet connector
AGENTDUET_API_KEY=your-connector-api-key
AGENTDUET_CONNECTOR_UUID=your-connector-uuid

# Gemini Live (after-hours AI voicemail)
GEMINI_API_KEY=

# OpenClaw → Slack (required for notify)
# Install OpenClaw, connect Slack, invite the bot to your channel.
# https://docs.openclaw.ai/
OPENCLAW_SLACK_TARGET=channel:C0123456789
# OPENCLAW_BIN=openclaw
# OPENCLAW_DRY_RUN=1

# Business hours (local wall clock in BUSINESS_TZ)
BUSINESS_TZ=UTC
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
BUSINESS_DAYS=0,1,2,3,4

# FORCE_AFTER_HOURS=1
# CONNECT_RING_SECONDS=30
